  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  opacity: 0;
  pointer-events: none;
  background: transparent;
  transition: opacity .12s ease;
}
.dw-hybrid.dw-live .dw-live-frame {
  position: relative;
  display: block;
  opacity: 1;
  pointer-events: auto;
}
.dw-hybrid.dw-live .dw-fallback {
  display: none;
}
</style><style id="archive-share-icons-fix">
.sno-story-social-icons .sno-row-icon {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
}
.sno-story-social-icons .sno-row-icon-ring {
  width: 42px !important;
  height: 42px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 !important;
  border: 0 !important;
}
.sno-story-social-icons .archive-share-svg {
  width: 19px;
  height: 19px;
  display: block;
  color: #fff;
}
.sno-story-social-icons .comment-row-icon { background:#2e7061 !important; color:#fff !important; }
.sno-story-social-icons .like-row-icon { background:#862635 !important; color:#fff !important; }
.sno-story-social-icons .facebook-row-icon { background:#3b5998 !important; color:#fff !important; }
.sno-story-social-icons .twitter-row-icon { background:#000 !important; color:#fff !important; }
.sno-story-social-icons .email-row-icon { background:#1f385c !important; color:#fff !important; }
.sno-story-social-icons .print-row-icon { background:#546b8b !important; color:#fff !important; border:0 !important; }
.sno-story-social-icons .sno-side-icon-bubble { display:none !important; }
</style><style id="archive-datawrapper-white-fix">
/* Match Datawrapper's normal white chart canvas in the local fallback. */
.archived-dw-chart,
.archived-dw-title,
.archived-dw-desc,
.archived-dw-credit,
.dw-fallback {
  background: #ffffff !important;
}
.archived-dw-chart {
  border: 0 !important;
}
.archived-dw-map-link,
.archived-datawrapper-map {
  background: #ffffff !important;
}
</style><style id="archive-footer-icons-fix">
.sno-hac-inner-desktop-footer-18 .sno-icon {
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
}
.sno-hac-inner-desktop-footer-18 .archive-footer-svg {
  width:20px;
  height:20px;
  display:block;
  color:#fff;
}
.sno-hac-inner-desktop-footer-18 .sno-icon i {
  display:none !important;
}
</style><style id="archive-all-ui-icons-fix">
.archive-ui-svg {
  width: 1em;
  height: 1em;
  display: inline-block;
  vertical-align: -0.12em;
  color: currentColor;
}
.sno-hac-submit-search-button .archive-ui-svg {
  width: 18px;
  height: 18px;
  vertical-align: middle;
}
.archive-icon-only {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
}
.bds-arrow .archive-ui-svg,
.bottom-drawer-toggle .archive-ui-svg,
.comment-close-icon .archive-ui-svg {
  width: 18px;
  height: 18px;
}
</style><style id="archive-external-link-behavior">
/* Portfolio mirror: original-site links open separately so the portfolio stays open. */
a[target="_blank"] { cursor: pointer; }
</style></head>
